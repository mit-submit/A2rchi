# syntax=docker/dockerfile:1
# NOTE: Using python:3.11 directly because the published a2rchi-python-base:latest
# on Docker Hub is stale (Python 3.10). SDK >=0.2.0 requires Python >=3.11.
FROM docker.io/library/python:3.11
RUN mkdir -p /root/archi
WORKDIR /root/archi

COPY LICENSE LICENSE

# Install Firefox and Geckodriver for Selenium 
RUN apt-get update && apt-get install -y \
    firefox-esr \
    wget \
    gnupg \
    ca-certificates \
    git \
    --no-install-recommends \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Geckodriver
RUN wget -q "https://github.com/mozilla/geckodriver/releases/download/v0.36.0/geckodriver-v0.36.0-linux64.tar.gz" \
    && tar -xzf "geckodriver-v0.36.0-linux64.tar.gz" -C /usr/local/bin \
    && chmod +x /usr/local/bin/geckodriver \
    && rm "geckodriver-v0.36.0-linux64.tar.gz"

COPY archi_code src
COPY configs configs
COPY pyproject.toml pyproject.toml
COPY git_info.yaml git_info.yaml
COPY weblists weblists

# Install base requirements first (same as a2rchi-python-base), then the archi package
RUN pip install --upgrade pip \
    && pip install -r src/cli/templates/dockerfiles/base-python-image/requirements.txt \
    && pip install .
# Re-install packages that pip install . may have removed or broken due to resolver conflicts
RUN pip install langchain-huggingface==1.0.0
RUN pip install pandas
RUN pip install ragas==0.3.5
RUN pip install 'argilla>=2.5,<3'
RUN pip install 'github-copilot-sdk>=0.2.0'
# Fix langgraph version mismatch: langgraph-prebuilt gets upgraded but langgraph stays pinned
RUN pip install 'langgraph>=1.0.3'

RUN chmod g+rx /root; chmod -R g+w /root/archi/src/interfaces

CMD ["python", "-u", "src/bin/service_benchmark.py"] 
